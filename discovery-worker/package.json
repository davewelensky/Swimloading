{
  "name": "discovery-worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SwimLoading Global Swim Discovery — candidate-event extraction worker. Deploys independently (Railway); never writes to the main app's Supabase project directly.",
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env src/index.ts",
    "process:fixtures": "node --import tsx --env-file-if-exists=.env src/index.ts --all",
    "crawl": "node --import tsx --env-file-if-exists=.env src/crawl.ts --once",
    "crawl:loop": "node --import tsx --env-file-if-exists=.env src/crawl.ts --loop",
    "crawl:url": "node --import tsx --env-file-if-exists=.env src/crawl.ts --url",
    "start": "node --import tsx src/crawl.ts --loop",
    "test": "node --import tsx --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
