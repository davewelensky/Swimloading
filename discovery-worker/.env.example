# Copy to .env (gitignored — never commit it).

# ── Safety gates ──────────────────────────────────────────────────────────
# Write mode. With it false, a run writes extraction output to out/*.json
# and nothing touches the database (scheduler modes still READ
# discovery_sources, so credentials are needed there either way).
#
# Setting it true requires BOTH Supabase variables below; the worker
# refuses to start otherwise rather than processing everything and only
# then discovering it had nowhere to write.
DISCOVERY_WRITE_ENABLED=false

# Live HTTP fetching (the crawler, src/crawl.ts). IMPLEMENTED, defaults
# off. The crawler refuses to make any network request without this flag.
DISCOVERY_LIVE_FETCH_ENABLED=false

# Headless-browser rendering (Playwright). IMPLEMENTED, defaults off.
# Only used as a FALLBACK, on pages where plain extraction found no event
# — the modern SPA case (Swimming South Africa serves "Fetching batch
# 1... (0 events loaded)"; Oceanman's race pages have zero body text).
#
# Requires the browser binary:  npx playwright install chromium
# Chromium needs roughly 1GB of RAM. On a memory-capped container it will
# be OOM-killed, so confirm headroom before enabling it on Railway.
DISCOVERY_PLAYWRIGHT_ENABLED=false
DISCOVERY_MAX_RENDERED_PAGES_PER_RUN=10
DISCOVERY_RENDER_TIMEOUT_MS=30000
DISCOVERY_RENDER_SETTLE_MS=1500

# AI-assisted extraction: the LAST resort, tried only after JSON-LD,
# tables, selectors and rendering have all found nothing on a page. The
# model transcribes a page into columns; it never resolves a year, parses
# a distance, supplies coordinates or produces a score. Requires
# ANTHROPIC_API_KEY and a positive DISCOVERY_MAX_AI_CALLS_PER_RUN — with
# either missing the worker refuses to start rather than silently doing
# nothing. Requires the 2026-08-04_extraction-method-ai-fallback migration.
DISCOVERY_AI_ENABLED=false
DISCOVERY_AI_MODEL=claude-opus-5
# Transcription, not reasoning — low is markedly cheaper and no worse here.
DISCOVERY_AI_EFFORT=low
# Condensed characters sent per page. ~4x the largest page measured across
# the seeded sources, so truncation should be rare; when it happens it is
# reported on the candidate, never silent.
DISCOVERY_AI_MAX_INPUT_CHARS=60000

# ── Crawl budgets & politeness ────────────────────────────────────────────
# Hard cap on pages fetched per source per run (listing + detail pages).
# Enforced. Anything over the cap is deferred to the source's next run.
DISCOVERY_MAX_PAGES_PER_RUN=25
# Hard per-run ceiling on AI calls — the only step that costs money per
# page. Measured ~$0.10/page on claude-opus-5, so 25 is roughly $2.50 per
# run worst case. Unchanged pages and pages under 400 condensed characters
# never make a call at all, so the real figure is usually far lower.
DISCOVERY_MAX_AI_CALLS_PER_RUN=0

# Identifiable bot UA — never a disguised browser string. Override only
# to bump the version.
# DISCOVERY_USER_AGENT=SwimLoadingDiscoveryBot/1.0 (+https://www.swimloading.com/explore; contact: dave.welensky@gmail.com)

# Politeness knobs (defaults shown). Minimum gap between requests to the
# same host; a site's robots.txt Crawl-delay is honoured up to the cap.
DISCOVERY_MIN_HOST_DELAY_MS=5000
DISCOVERY_MAX_CRAWL_DELAY_MS=30000
DISCOVERY_FETCH_TIMEOUT_MS=20000
DISCOVERY_FETCH_MAX_RETRIES=3
DISCOVERY_MAX_RESPONSE_BYTES=5242880

# Scheduler: sources processed per pass, and (loop mode) seconds between
# passes. Sources are due by next_run_at + crawl_frequency, with
# exponential backoff on consecutive failures.
DISCOVERY_MAX_SOURCES_PER_PASS=10
DISCOVERY_SCHEDULER_INTERVAL_SECONDS=900

# ── Supabase ──────────────────────────────────────────────────────────────
# Required for write mode AND for the scheduler modes (which read
# discovery_sources). SUPABASE_SERVICE_KEY bypasses RLS completely. It
# belongs only in this server-side worker (local .env, or Railway's
# environment) — never in browser code, never committed, never logged.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────
# Required only when DISCOVERY_AI_ENABLED=true. Server-side worker only —
# never in browser code, never committed, never logged.
ANTHROPIC_API_KEY=
