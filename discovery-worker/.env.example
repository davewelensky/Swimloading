# Copy to .env (gitignored — never commit it).

# ── Safety gates ──────────────────────────────────────────────────────────
# Write mode is IMPLEMENTED but defaults to OFF. With it false, a run is a
# pure dry-run: fixtures in, out/*.json out, nothing touches the database.
#
# Setting it true requires BOTH Supabase variables below; the worker
# refuses to start otherwise rather than processing everything and only
# then discovering it had nowhere to write.
DISCOVERY_WRITE_ENABLED=false

# Still NOT implemented. Setting any of these to true refuses to start.
DISCOVERY_LIVE_FETCH_ENABLED=false
DISCOVERY_PLAYWRIGHT_ENABLED=false
DISCOVERY_AI_ENABLED=false

# Hard caps for a future phase (live fetch / AI fallback). Read but not
# yet enforced against anything real, since neither capability exists.
DISCOVERY_MAX_PAGES_PER_RUN=5
DISCOVERY_MAX_AI_CALLS_PER_RUN=0

# ── Supabase (required ONLY when DISCOVERY_WRITE_ENABLED=true) ────────────
# SUPABASE_SERVICE_KEY bypasses RLS completely. It belongs only in this
# server-side worker (local .env, or Railway's environment) — never in
# browser code, never committed, never logged.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
