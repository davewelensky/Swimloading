# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local — they are gitignored.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://www.swimloading.com/api/strava/callback
STRAVA_HMAC_SECRET=

# Anthropic (Claude — used by Sets Planner)
ANTHROPIC_API_KEY=

# my-water.live live sensor API
# Get your key from https://my-water.live/api/
# Add venues in api/mywaterlive-config.js — no code changes needed.
MYWATERLIVE_API_KEY=

# Social Content Engine: Facebook Page publishing (see docs/social-engine/FACEBOOK_SETUP.md)
# Publishing stays OFF unless SOCIAL_PUBLISH_ENABLED=true. Never commit real values.
META_PAGE_ID=
META_PAGE_TOKEN=
SOCIAL_PUBLISH_ENABLED=false
